# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://mentor:mentor@localhost:5432/mentorbridgex

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mentorbridgex

# Redis
REDIS_URL=redis://localhost:6379/0

# Adapters (mock | openai — openai not implemented in MVP)
ML_ADAPTER=mock
EMBEDDING_ADAPTER=mock

# Docker 없이 로컬 실행 (메모리 DB)
OFFLINE_DEMO=false

# Daglo STT (optional — leave empty to disable live STT client)
DAGLO_API_TOKEN=
DAGLO_BASE_URL=https://apis.daglo.ai
DAGLO_TIMEOUT_SECONDS=30
