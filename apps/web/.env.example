# ── API 베이스 URL ──────────────────────────────────────────────────────────
# 배포 환경: 실제 백엔드 서버 URL로 교체하세요
VITE_API_BASE_URL=https://api.teamcodebridge.dev

# 로컬 개발: 아래 줄 주석 해제 (vite.config.js 프록시와 함께 사용)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ── Google OAuth (콘솔 Client ID — 공개값) ────────────────────────────────
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# VITE_GOOGLE_REDIRECT_URI=https://mbx.teamcodebridge.dev/oauth/callback
# 로컬: VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ── 개발용 계정 (dev-login) ────────────────────────────────────────────────
# 백엔드 /v1/auth/dev-login 은 이메일만으로 토큰 발급 (비밀번호 검증 없음)
# VITE_DEV_STUDENT_EMAIL=hong@school.ac.kr
# VITE_DEV_TEACHER_EMAIL=sujin@school.ac.kr
# VITE_DEV_ADMIN_EMAIL=admin@school.ac.kr
